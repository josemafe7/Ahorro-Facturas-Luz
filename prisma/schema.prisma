// La estructura de la base de datos. Se cambia aquí y Prisma crea la migración (ver docs/conventions.md).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------------------------------------
// Usuarios y sesiones. Son las tablas que necesita Better Auth: sus nombres y campos los marca la librería.
// ---------------------------------------------------------------------------------------------------------

model User {
  id            String           @id
  name          String
  email         String           @unique
  emailVerified Boolean          @default(false)
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sessions      Session[]
  accounts      Account[]
  settings      SectorSettings[]
  offers        Offer[]
  files         StoredFile[]
  studies       Study[]
  aiReadings    AiReading[]
  brand         AdvisorBrand?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

// La contraseña, cifrada de forma irreversible, vive aquí y no en `user`.
model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------------------------------------
// Los datos de la app. Toda tabla con datos de un asesor lleva `userId`, su dueño (docs/security.md).
// Lo propio de cada sector se guarda como JSON en `data`: lo valida el módulo del sector al leer y al guardar.
// ---------------------------------------------------------------------------------------------------------

/// Los impuestos y cargos con los que calcula cada asesor.
model SectorSettings {
  userId    String
  sector    String
  data      String
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, sector])
  @@map("sector_settings")
}

/// Una oferta del catálogo de un asesor. En la luz, una tarifa.
model Offer {
  id        String   @id @default(cuid())
  userId    String
  sector    String
  data      String
  /// Las inactivas se conservan, pero no entran en las comparaciones.
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sector])
  @@map("offer")
}

/// Un archivo subido por un asesor: una factura, un tarifario o su logo. Vive en la carpeta privada.
model StoredFile {
  id         String         @id @default(cuid())
  userId     String
  /// El nombre con el que está guardado: aleatorio, nunca el original.
  storageKey String         @unique
  mimeType   String
  size       Int
  createdAt  DateTime       @default(now())
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  studies    Study[]
  brands     AdvisorBrand[]

  @@index([userId])
  @@map("stored_file")
}

/// Un estudio: de la factura del cliente a la propuesta.
model Study {
  id               String      @id @default(cuid())
  userId           String
  sector           String
  /// draft, sent, accepted o contracted
  status           String      @default("draft")
  /// El titular, para la lista.
  customerName     String?
  fileId           String?
  /// Cómo fue la lectura con IA: read, not-recognized, failed, limit o not-configured.
  readingStatus    String?
  /// Los datos del documento tal como están ahora, revisados o no.
  draft            String      @default("{}")
  /// Los datos que conviene revisar y por qué.
  doubts           String      @default("{}")
  /// Cuándo dio el asesor los datos por buenos. Sin esto no hay cálculo.
  reviewedAt       DateTime?
  /// El cálculo guardado: lo que paga hoy y lo que pagaría con cada oferta, con sus precios e impuestos de
  /// ese momento. No cambia aunque después cambien el catálogo o los ajustes.
  calculation      String?
  /// La oferta elegida para el estudio, dentro del cálculo guardado.
  selectedOfferId  String?
  /// Para la lista: el nombre de la oferta elegida y su ahorro anual, en céntimos.
  proposedOffer    String?
  yearSavingsCents Int?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  file             StoredFile? @relation(fields: [fileId], references: [id])

  @@index([userId, sector, createdAt])
  @@map("study")
}

/// Cada lectura de IA que pide un asesor, para aplicar el límite por hora.
model AiReading {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("ai_reading")
}

/// La marca del asesor, que es la que sale en el PDF del estudio.
model AdvisorBrand {
  userId       String      @id
  businessName String
  /// El color principal, como #RRGGBB.
  color        String
  phone        String?
  email        String?
  website      String?
  logoFileId   String?
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  logo         StoredFile? @relation(fields: [logoFileId], references: [id])

  @@map("advisor_brand")
}

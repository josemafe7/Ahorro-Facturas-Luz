# Los nombres de las claves que necesita la app, sin sus valores. Copia este archivo como .env.local y
# rellénalo. .env.local nunca se sube a Git.

# Protege las sesiones de los usuarios. Genera una con: openssl rand -base64 32
BETTER_AUTH_SECRET=

# La dirección pública de la app. Solo hace falta al publicarla: en local se admite cualquier puerto de
# este ordenador.
# BETTER_AUTH_URL=https://tu-dominio.example

# La clave de OpenRouter, que paga las lecturas de la IA. Se crea en https://openrouter.ai/keys
OPENROUTER_API_KEY=
